{
  "name": "@ignes/core",
  "version": "1.0.0",
  "description": "Backend API for IGNES VPN platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:reset": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed"
  },
  "keywords": [
    "ignes",
    "vpn",
    "backend",
    "express"
  ],
  "author": "Ignes IT",
  "license": "MIT",
  "dependencies": {
    "@ignes/shared": "file:../IGNES-Shared",
    "@prisma/client": "^5.18.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "^5.18.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
